{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "InteractivesClient": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "skipTests": true,
          "style": "scss"
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/primeicons/primeicons.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/base/base.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/button/button.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/tooltip/tooltip.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/popup/popup.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/dialog/dialog.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/sidebar/sidebar.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/input/input.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/textbox/textbox.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/textarea/textarea.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/numerictextbox/index.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/datepicker/index.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/datetimepicker/index.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/timepicker/index.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/color-picker/index.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/drop-down-base/index.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/drop-down-list/index.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/multi-select/index.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/check-box/index.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/radio-button/index.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/rich-text-editor/index.css",
              "node_modules/@syncfusion/ej2-tailwind3-theme/styles/uploader/index.css",
              "src/styles.scss"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": ["localhost", "127.0.0.1"]
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.5MB",
                  "maximumError": "3MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.production.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "InteractivesClient:build:production"
            },
            "development": {
              "buildTarget": "InteractivesClient:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "InteractivesClient:build:development",
            "runner": "vitest",
            "tsConfig": "tsconfig.spec.json",
            "runnerConfig": "vitest-base.config.ts"
          }
        }
      }
    }
  }
}
